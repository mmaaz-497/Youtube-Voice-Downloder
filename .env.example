# YouTube Audio Extractor (MP3) — environment configuration
# Copy to .env and uncomment to override. Every value below shows its default
# (see specs/002-extract-audio/data-model.md, Config table).

# Directory for transient extraction artifacts (UUID-named files).
# Default: OS temp subdir (e.g. <system temp>/yt-audio-extractor)
#WORK_DIR=

# Concurrent extraction workers. Default: max(2, cpu_count)
#MAX_CONCURRENCY=

# Global admission queue bound. Default: 10 x MAX_CONCURRENCY
#QUEUE_LIMIT=

# Max simultaneously active (queued+running) jobs per origin. Default: 3
#PER_ORIGIN_CAP=3

# Refuse/fail extraction when free disk drops below this. Default: 1 GiB
#DISK_FLOOR_BYTES=1073741824

# Seconds an unretrieved result lives after the job finishes. Default: 900
#TTL_SECONDS=900

# Seconds between TTL/orphan-file sweep passes. Default: 60
#SWEEP_INTERVAL_SECONDS=60

# Watchdog for the downloading phase, seconds. Default: 600
#DOWNLOAD_TIMEOUT_SECONDS=600

# Watchdog for the converting phase, seconds. Default: 300
#TRANSCODE_TIMEOUT_SECONDS=300

# Longest accepted video duration, seconds. Default: 3600
#MAX_DURATION_SECONDS=3600

# Kill the metadata probe after this many seconds (surfaces NETWORK_ERROR). Default: 15
#PROBE_TIMEOUT_SECONDS=15

# Set to 1 only behind a single trusted reverse proxy: origin IP is then the
# rightmost X-Forwarded-For value. Default: 0 (socket IP; XFF ignored)
#TRUSTED_PROXY=0

# Set to 1 to enable the real yt-dlp/FFmpeg smoke test (never in CI). Default: 0
#REAL_STACK=0
